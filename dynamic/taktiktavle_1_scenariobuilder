<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Taktiktavle: Scenarie-bygger</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
        }

        .font-mono-code {
            font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }

        /* Canvas container maintains exact 400:550 aspect ratio */
        .pitch-wrapper {
            position: relative;
            width: 100%;
            max-width: 400px;
            aspect-ratio: 400 / 550;
            margin: 0 auto;
            border-radius: 0.75rem;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.15), 0 8px 10px -6px rgba(15, 23, 42, 0.1);
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
        }

        #editorCanvas {
            display: block;
            width: 100%;
            height: 100%;
            cursor: grab;
        }

        #editorCanvas.dragging {
            cursor: grabbing;
        }

        /* Custom subtle scrollbar for code block */
        .code-scroll::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        .code-scroll::-webkit-scrollbar-track {
            background: #1e293b;
            border-radius: 4px;
        }
        .code-scroll::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        .code-scroll::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }

        /* Syntax highlight colors for dark code viewer */
        .tok-key { color: #93c5fd; }
        .tok-str { color: #86efac; }
        .tok-num { color: #fcd34d; }
        .tok-bool { color: #f472b6; }
        .tok-punc { color: #94a3b8; }

        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-toast {
            animation: fadeSlideUp 0.25s ease-out forwards;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Dark Header -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-green-600 flex items-center justify-center shadow-inner text-xl">
                    ⚽
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-extrabold tracking-tight leading-tight">
                        Taktiktavle: Scenarie-bygger
                    </h1>
                    <p class="text-xs text-slate-400">
                        Design scenarier &amp; eksportér direkte til dit 400×550 fodboldspil
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <!-- Reset button with inline two-step confirm (no native confirm()) -->
                <button id="btn-reset" type="button"
                    class="px-3.5 py-2 rounded-lg text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors flex items-center gap-1.5">
                    <span>↺</span>
                    <span id="btn-reset-text">Nulstil / Ny skabelon</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Workspace -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- LEFT PANEL: Interactive Tactical Pitch -->
            <section class="lg:col-span-5 bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-5 flex flex-col gap-4">
                
                <!-- Mode Tabs above Canvas -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Redigeringstilstand</span>
                        <span id="mode-hint" class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">
                            Træk spillere &amp; zoner
                        </span>
                    </div>
                    <div class="grid grid-cols-4 gap-1.5 bg-slate-100 p-1 rounded-xl" role="tablist">
                        <button type="button" data-mode="setup"
                            class="mode-tab py-2 px-1.5 rounded-lg text-xs font-bold transition-all text-center">
                            Start
                        </button>
                        <button type="button" data-mode="A"
                            class="mode-tab py-2 px-1.5 rounded-lg text-xs font-bold transition-all text-center">
                            Udfald A
                        </button>
                        <button type="button" data-mode="B"
                            class="mode-tab py-2 px-1.5 rounded-lg text-xs font-bold transition-all text-center">
                            Udfald B
                        </button>
                        <button type="button" data-mode="C"
                            class="mode-tab py-2 px-1.5 rounded-lg text-xs font-bold transition-all text-center">
                            Udfald C
                        </button>
                    </div>
                </div>

                <!-- Helper Toggles -->
                <div class="flex flex-wrap items-center justify-between gap-2 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs">
                    <label class="flex items-center gap-2 cursor-pointer select-none font-medium text-slate-700">
                        <input id="toggle-shadow" type="checkbox" checked class="w-4 h-4 rounded accent-slate-800 cursor-pointer">
                        <span>Vis pasningsskygge (hjælpelinje)</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer select-none font-medium text-slate-700">
                        <input id="toggle-grid" type="checkbox" checked class="w-4 h-4 rounded accent-blue-600 cursor-pointer">
                        <span>Snap til gitter (10px)</span>
                    </label>
                </div>

                <!-- 400x550 Tactical Canvas -->
                <div class="pitch-wrapper">
                    <canvas id="editorCanvas" width="400" height="550"></canvas>

                    <!-- Live Coordinate Badge during Drag -->
                    <div id="coord-badge"
                        class="hidden absolute top-2.5 left-2.5 bg-slate-900/90 text-white text-xs font-mono-code px-2.5 py-1 rounded-lg shadow pointer-events-none z-10">
                        x: 200, y: 350
                    </div>

                    <!-- Preview Phase Indicator -->
                    <div id="preview-status"
                        class="hidden absolute top-2.5 right-2.5 bg-amber-500 text-slate-950 text-xs font-bold px-2.5 py-1 rounded-full shadow pointer-events-none z-10">
                        Afspiller...
                    </div>

                    <!-- Feedback Banner at End of Live Animation Preview -->
                    <div id="preview-feedback-overlay"
                        class="hidden absolute inset-x-3 bottom-3 bg-white/95 backdrop-blur-sm rounded-xl p-3.5 shadow-xl border border-slate-200 z-20 animate-toast">
                        <div class="flex items-start gap-2.5">
                            <div id="preview-fb-icon" class="text-2xl leading-none shrink-0">⚽️</div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-2">
                                    <h4 id="preview-fb-title" class="text-sm font-extrabold text-slate-900 truncate">Fremragende løb!</h4>
                                    <button id="btn-close-preview" type="button"
                                        class="text-xs font-bold text-slate-500 hover:text-slate-800 px-1.5 py-0.5 rounded bg-slate-100">
                                        Luk
                                    </button>
                                </div>
                                <p id="preview-fb-text" class="text-xs text-slate-600 mt-1 leading-relaxed"></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Outcome Quick Actions (Shown in Outcome Mode A, B, or C) -->
                <div id="outcome-actions" class="hidden bg-slate-50 border border-slate-200 rounded-xl p-3 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-700">Hurtig-knapper for Udfald <span id="outcome-zone-label">A</span></span>
                        <span class="text-[11px] text-slate-500">Træk 1, F eller bolden på banen</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <button id="btn-ball-to-zone" type="button"
                            class="px-2.5 py-2 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white transition-colors shadow-sm">
                            Bold → Zone (Pasning lykkes)
                        </button>
                        <button id="btn-ball-to-def" type="button"
                            class="px-2.5 py-2 rounded-lg text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white transition-colors shadow-sm">
                            Bold → Forsvar (Opsnappet)
                        </button>
                        <button id="btn-reset-outcome" type="button"
                            class="px-2.5 py-2 rounded-lg text-xs font-semibold bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 transition-colors">
                            Nulstil slutpositioner
                        </button>
                    </div>
                </div>

                <!-- Live Animation Preview Bar -->
                <div class="bg-slate-900 rounded-xl p-3 text-white flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold text-slate-300">Test-animation:</span>
                        <select id="preview-zone-select"
                            class="bg-slate-800 border border-slate-700 text-white text-xs font-bold rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="A">Zone A</option>
                            <option value="B">Zone B</option>
                            <option value="C" selected>Zone C</option>
                        </select>
                    </div>
                    <button id="btn-play-preview" type="button"
                        class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-500 active:scale-95 text-white transition-all flex items-center justify-center gap-1.5 shadow">
                        <span id="play-icon">▶</span>
                        <span id="play-label">Afspil test-animation</span>
                    </button>
                </div>

                <!-- Legend -->
                <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[11px] text-slate-500 pt-1">
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-blue-600 inline-block border border-white shadow-sm"></span> 1: Boldholder</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block border border-white shadow-sm"></span> 2: Medspiller</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-white shadow-sm"></span> F: Forsvar</span>
                    <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full border-2 border-dashed border-yellow-400 bg-yellow-300/30 inline-block"></span> Zoner A/B/C</span>
                </div>
            </section>

            <!-- RIGHT PANEL: Scenario Info, Zone Settings & Code Output -->
            <section class="lg:col-span-7 flex flex-col gap-5">

                <!-- 1. Scenarie Info Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
                    <h2 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 mb-3 flex items-center gap-2">
                        <span class="w-6 h-6 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">1</span>
                        Scenarie Info
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                        <div>
                            <label for="input-id" class="block text-xs font-semibold text-slate-600 mb-1">ID (nummer)</label>
                            <input id="input-id" type="number" min="1" step="1" value="6"
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div class="sm:col-span-3">
                            <label for="input-title" class="block text-xs font-semibold text-slate-600 mb-1">Scenarie Titel</label>
                            <input id="input-title" type="text" placeholder="F.eks. Skab trekanten"
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div class="sm:col-span-4">
                            <label for="input-desc" class="block text-xs font-semibold text-slate-600 mb-1">Beskrivelse (vises i intro-boksen)</label>
                            <textarea id="input-desc" rows="2" placeholder="Forklar situationen for spilleren..."
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-y"></textarea>
                        </div>
                    </div>
                </div>

                <!-- 2. Zone-indstillinger Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <h2 class="text-sm font-extrabold uppercase tracking-wider text-slate-800 flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">2</span>
                            Zone-indstillinger
                        </h2>
                        <!-- Zone Tabs A, B, C -->
                        <div class="flex gap-1.5 bg-slate-100 p-1 rounded-xl">
                            <button type="button" data-zone-tab="A" class="zone-tab px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5">
                                Zone A <span id="badge-correct-A" class="hidden w-2 h-2 rounded-full bg-emerald-500"></span>
                            </button>
                            <button type="button" data-zone-tab="B" class="zone-tab px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5">
                                Zone B <span id="badge-correct-B" class="hidden w-2 h-2 rounded-full bg-emerald-500"></span>
                            </button>
                            <button type="button" data-zone-tab="C" class="zone-tab px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5">
                                Zone C <span id="badge-correct-C" class="hidden w-2 h-2 rounded-full bg-emerald-500"></span>
                            </button>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-end">
                            <div>
                                <label for="zone-label" class="block text-xs font-semibold text-slate-600 mb-1">Zone Label (kort navn)</label>
                                <input id="zone-label" type="text" placeholder="F.eks. Træd ud"
                                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>

                            <!-- Correct Solution Toggle -->
                            <div class="flex items-center justify-between bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2">
                                <label for="zone-correct" class="flex items-center gap-2.5 cursor-pointer select-none">
                                    <input id="zone-correct" type="checkbox" class="w-4 h-4 rounded accent-emerald-600 cursor-pointer">
                                    <span class="text-xs font-bold text-slate-700">Korrekt løsning?</span>
                                </label>
                                <span id="zone-correct-pill" class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-200 text-slate-600">
                                    Forkert
                                </span>
                            </div>
                        </div>

                        <!-- Radius Slider & Manual Coordinates -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-slate-50 border border-slate-200 rounded-xl p-3">
                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label for="zone-radius" class="text-xs font-semibold text-slate-600">Zone Radius (r)</label>
                                    <span id="zone-radius-val" class="text-xs font-mono-code font-bold text-blue-600">35 px</span>
                                </div>
                                <input id="zone-radius" type="range" min="20" max="60" value="35"
                                    class="w-full accent-blue-600 cursor-pointer">
                            </div>

                            <div>
                                <span class="block text-xs font-semibold text-slate-600 mb-1">Zone Position (x, y)</span>
                                <div class="grid grid-cols-2 gap-2">
                                    <div class="flex items-center bg-white border border-slate-300 rounded-lg px-2 py-1">
                                        <span class="text-[11px] font-bold text-slate-400 mr-1.5">X</span>
                                        <input id="zone-x" type="number" min="0" max="400"
                                            class="w-full text-xs font-mono-code font-semibold focus:outline-none">
                                    </div>
                                    <div class="flex items-center bg-white border border-slate-300 rounded-lg px-2 py-1">
                                        <span class="text-[11px] font-bold text-slate-400 mr-1.5">Y</span>
                                        <input id="zone-y" type="number" min="0" max="550"
                                            class="w-full text-xs font-mono-code font-semibold focus:outline-none">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Feedback Textarea -->
                        <div>
                            <label for="zone-feedback" class="block text-xs font-semibold text-slate-600 mb-1">
                                Feedback tekst (vises når spilleren vælger denne zone)
                            </label>
                            <textarea id="zone-feedback" rows="2" placeholder="Forklar hvorfor dette valg er godt eller skidt..."
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
                        </div>

                        <!-- Outcome Coordinate Readout + Quick Switch to Edit Outcome -->
                        <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 text-xs">
                            <div class="font-mono-code text-[11px] text-slate-500 flex flex-wrap gap-x-3 gap-y-1">
                                <span>p1_end: <strong id="ro-p1-end" class="text-slate-700">(200, 480)</strong></span>
                                <span>d_end: <strong id="ro-d-end" class="text-slate-700">(220, 380)</strong></span>
                                <span>ball_end: <strong id="ro-ball-end" class="text-slate-700">(320, 300)</strong></span>
                            </div>
                            <button id="btn-edit-zone-outcome" type="button"
                                class="text-xs font-bold text-blue-600 hover:text-blue-800 hover:underline">
                                Redigér slutpositioner på banen →
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3. Eksportér Kode Card -->
                <div class="bg-slate-900 rounded-2xl shadow-md border border-slate-800 p-5 text-white">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                        <h2 class="text-sm font-extrabold uppercase tracking-wider text-white flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-slate-800 text-emerald-400 flex items-center justify-center text-xs">3</span>
                            Eksportér Kode
                        </h2>
                        <div class="flex flex-wrap items-center gap-3">
                            <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer select-none">
                                <input id="toggle-comma" type="checkbox" checked class="w-4 h-4 rounded accent-emerald-500 cursor-pointer">
                                <span>Inkludér komma til sidst</span>
                            </label>
                            <button id="btn-copy-code" type="button"
                                class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500 hover:bg-emerald-400 active:scale-95 text-slate-950 transition-all shadow-lg flex items-center gap-1.5">
                                <span id="copy-icon">📋</span>
                                <span id="copy-label">Kopiér kode</span>
                            </button>
                        </div>
                    </div>

                    <p class="text-xs text-slate-400 mb-3">
                        Indsæt denne blok direkte i <code class="text-amber-300 bg-slate-800 px-1.5 py-0.5 rounded">const scenarios = [ ... ]</code> i din HTML-fil.
                    </p>

                    <div class="bg-slate-950 rounded-xl border border-slate-800 p-3.5 overflow-x-auto code-scroll max-h-80">
                        <pre class="font-mono-code text-xs leading-relaxed m-0"><code id="code-output"></code></pre>
                    </div>
                </div>

            </section>
        </div>
    </main>

    <!-- Floating Toast Notification -->
    <div id="toast" class="hidden fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border border-slate-700 text-sm font-semibold flex items-center gap-2 animate-toast">
        <span class="text-emerald-400">✓</span>
        <span id="toast-msg">Koden er kopieret til udklipsholderen!</span>
    </div>

<script>
    // =========================================================================
    // 1. DEFAULT TEMPLATE & APPLICATION STATE
    // =========================================================================
    const CANVAS_W = 400;
    const CANVAS_H = 550;

    function createDefaultScenario() {
        return {
            id: 6,
            title: "Træd ud af skyggen",
            desc: "Forsvarsspilleren spærrer den direkte pasning. Hvor skal du løbe hen for at åbne pasningslinjen?",
            start: {
                p1: { x: 200, y: 480 },
                p2: { x: 200, y: 240 },
                d:  { x: 200, y: 350 }
            },
            zones: [
                {
                    id: 'A',
                    label: 'Bliv i skyggen',
                    x: 200,
                    y: 150,
                    r: 35,
                    correct: false,
                    feedback: "Du står stadig i forsvarsspillerens skygge! Bolden bliver opsnappet.",
                    p1_end: { x: 200, y: 480 },
                    d_end:  { x: 200, y: 350 },
                    ball_end: { x: 200, y: 350 }
                },
                {
                    id: 'B',
                    label: 'Tæt på bold',
                    x: 190,
                    y: 410,
                    r: 35,
                    correct: false,
                    feedback: "Du kommer for tæt på boldholderen, så én forsvarsspiller kan dække jer begge.",
                    p1_end: { x: 200, y: 480 },
                    d_end:  { x: 200, y: 430 },
                    ball_end: { x: 200, y: 430 }
                },
                {
                    id: 'C',
                    label: 'Træd ud',
                    x: 320,
                    y: 300,
                    r: 35,
                    correct: true,
                    feedback: "Helt perfekt! Du træder ud af pasningsskyggen og skaber en fri pasningslinje.",
                    p1_end: { x: 200, y: 480 },
                    d_end:  { x: 230, y: 370 },
                    ball_end: { x: 320, y: 300 }
                }
            ]
        };
    }

    let scenario = createDefaultScenario();
    let activeMode = 'setup'; // 'setup' | 'A' | 'B' | 'C'
    let activeZoneTab = 'C';  // 'A' | 'B' | 'C'
    let showShadow = true;
    let snapToGrid = true;
    let includeTrailingComma = true;

    // Drag state
    let dragTarget = null; // { kind: 'p1'|'p2'|'d'|'zone'|'p1_end'|'d_end'|'ball_end', zoneIdx?: number }
    let resetConfirmPending = false;
    let resetConfirmTimeout = null;

    // Animation Preview state
    const P2_ANIM_DURATION = 1000;
    const OUTCOME_ANIM_DURATION = 1200;
    let preview = {
        active: false,
        zoneId: 'C',
        phase: 0, // 1 = P2 runs, 2 = P1/D/Ball react, 3 = Finished
        startTime: 0,
        p1: { x: 0, y: 0 },
        p2: { x: 0, y: 0 },
        d: { x: 0, y: 0 },
        ball: { x: 0, y: 0 }
    };

    // =========================================================================
    // 2. DOM REFERENCES
    // =========================================================================
    const canvas = document.getElementById('editorCanvas');
    const ctx = canvas.getContext('2d');

